{
  "name": "OrganizationMember",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "organization_owner",
        "organization_admin",
        "representative",
        "video_analyst",
        "performance_staff",
        "medical_staff"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "disabled"
      ],
      "default": "pending"
    },
    "has_full_squad_access": {
      "type": "boolean",
      "default": false
    },
    "is_owner": {
      "type": "boolean",
      "default": false
    },
    "membership_key": {
      "type": "string",
      "description": "Unique key: organization_id:user_id or organization_id:user_email for invitations"
    }
  },
  "required": [
    "organization_id",
    "app_role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}