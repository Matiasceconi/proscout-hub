{
  "name": "TechnicalStaffMember",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "director_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "ayudante_campo",
        "preparador_fisico",
        "entrenador_arqueros",
        "analista_video",
        "otro"
      ],
      "default": "ayudante_campo"
    },
    "nationality": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "director_id",
    "full_name",
    "role"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}