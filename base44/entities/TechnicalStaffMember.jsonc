{
  "name": "TechnicalStaffMember",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "director_id": {
      "type": "string"
    },
    "linked_technical_director_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "ayudante_campo",
        "preparador_fisico",
        "entrenador_arqueros",
        "analista_video",
        "medico",
        "kinesiologo",
        "nutricionista",
        "psicologo_deportivo",
        "coordinador",
        "otro"
      ],
      "default": "ayudante_campo"
    },
    "club": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "historical"
      ],
      "default": "active"
    },
    "nationality": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "director_id",
    "full_name",
    "role"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}