{
  "name": "PlayerMatchStats",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "club_fixture_id": {
      "type": "string",
      "description": "Reference to ClubFixture ID"
    },
    "api_player_id": {
      "type": "number",
      "description": "API-Football player ID"
    },
    "match_date": {
      "type": "string",
      "format": "date"
    },
    "season": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "opponent": {
      "type": "string"
    },
    "is_starter": {
      "type": "boolean",
      "default": false
    },
    "called_up": {
      "type": "boolean",
      "default": true
    },
    "callup_status": {
      "type": "string",
      "enum": [
        "called_up",
        "starter",
        "substitute",
        "not_called",
        "unconfirmed"
      ],
      "default": "unconfirmed"
    },
    "match_position": {
      "type": "string"
    },
    "minutes_played": {
      "type": "number",
      "default": 0
    },
    "goals": {
      "type": "number",
      "default": 0
    },
    "assists": {
      "type": "number",
      "default": 0
    },
    "penalties_scored": {
      "type": "number",
      "default": 0
    },
    "shots_total": {
      "type": "number",
      "default": 0
    },
    "shots_on": {
      "type": "number",
      "default": 0
    },
    "passes_total": {
      "type": "number",
      "default": 0
    },
    "passes_key": {
      "type": "number",
      "default": 0
    },
    "passes_accuracy": {
      "type": "number",
      "default": 0
    },
    "dribbles_attempts": {
      "type": "number",
      "default": 0
    },
    "dribbles_success": {
      "type": "number",
      "default": 0
    },
    "duels_total": {
      "type": "number",
      "default": 0
    },
    "duels_won": {
      "type": "number",
      "default": 0
    },
    "fouls_committed": {
      "type": "number",
      "default": 0
    },
    "fouls_drawn": {
      "type": "number",
      "default": 0
    },
    "tackles_total": {
      "type": "number",
      "default": 0
    },
    "tackles_blocks": {
      "type": "number",
      "default": 0
    },
    "tackles_interceptions": {
      "type": "number",
      "default": 0
    },
    "defensive_saved": {
      "type": "number",
      "default": 0
    },
    "defensive_blocked": {
      "type": "number",
      "default": 0
    },
    "defensive_clearances": {
      "type": "number",
      "default": 0
    },
    "yellow_cards": {
      "type": "number",
      "default": 0
    },
    "red_cards": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number"
    },
    "injury_or_incident": {
      "type": "string"
    },
    "agent_observations": {
      "type": "string"
    },
    "follow_up_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "not_required"
      ],
      "default": "pending"
    },
    "next_action": {
      "type": "string"
    },
    "responsible_agent": {
      "type": "string"
    },
    "extra_stats": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "match_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}