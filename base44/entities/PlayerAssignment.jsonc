{
  "name": "PlayerAssignment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "staff_user_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "staff_role": {
      "type": "string",
      "enum": [
        "representative",
        "video_analyst",
        "performance_staff",
        "medical_staff"
      ]
    },
    "assigned_by": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "staff_user_id",
    "staff_role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}