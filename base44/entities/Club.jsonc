{
  "name": "Club",
  "type": "object",
  "properties": {
    "club_key": {
      "type": "string",
      "description": "Unique key from source, e.g. tm-club-25358"
    },
    "club_name": {
      "type": "string"
    },
    "aliases": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "official_logo_url": {
      "type": "string",
      "description": "External source logo URL"
    },
    "internal_logo_url": {
      "type": "string",
      "description": "Base44 internal storage URL for the logo"
    },
    "logo_source_url": {
      "type": "string"
    },
    "logo_verified_date": {
      "type": "string",
      "format": "date"
    },
    "verification_status": {
      "type": "string"
    },
    "transfermarkt_club_id": {
      "type": "string"
    },
    "club_profile_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "club_key",
    "club_name"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}