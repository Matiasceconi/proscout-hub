{
  "name": "OpponentAnalysis",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "match_date": {
      "type": "string",
      "format": "date"
    },
    "opponent_team": {
      "type": "string"
    },
    "opponent_player_name": {
      "type": "string"
    },
    "opponent_player_position": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "strengths": {
      "type": "string"
    },
    "weaknesses": {
      "type": "string"
    },
    "recommendations": {
      "type": "string"
    },
    "video_clips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "published_date": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_by_player_date": {
      "type": "string",
      "format": "date-time"
    },
    "marked_as_seen": {
      "type": "boolean",
      "default": false
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "opponent_player_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.player_id": "{{user.data.player_id}}"
            },
            {
              "data.status": "published"
            }
          ]
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.player_id": "{{user.data.player_id}}"
        }
      ]
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}