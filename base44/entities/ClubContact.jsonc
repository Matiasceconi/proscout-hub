{
  "name": "ClubContact",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "relationship_status": {
      "type": "string",
      "enum": [
        "active",
        "warm",
        "cold",
        "inactive"
      ],
      "default": "active"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "club_id",
    "full_name"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}