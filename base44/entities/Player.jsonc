{
  "name": "Player",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "nationality": {
      "type": "string"
    },
    "second_nationality": {
      "type": "string"
    },
    "position": {
      "type": "string",
      "enum": [
        "GK",
        "CB",
        "LB",
        "RB",
        "CDM",
        "CM",
        "CAM",
        "LW",
        "RW",
        "ST",
        "CF"
      ]
    },
    "secondary_position": {
      "type": "string",
      "enum": [
        "GK",
        "CB",
        "LB",
        "RB",
        "CDM",
        "CM",
        "CAM",
        "LW",
        "RW",
        "ST",
        "CF"
      ]
    },
    "preferred_foot": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "both"
      ]
    },
    "club": {
      "type": "string"
    },
    "club_logo_url": {
      "type": "string"
    },
    "club_country": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "photo_source_url": {
      "type": "string"
    },
    "photo_source_name": {
      "type": "string"
    },
    "photo_source_type": {
      "type": "string",
      "enum": [
        "authorized",
        "official_club",
        "league_federation",
        "verified_channel",
        "public_reference"
      ]
    },
    "photo_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "photo_rights_status": {
      "type": "string"
    },
    "photo_status": {
      "type": "string",
      "enum": [
        "ok",
        "pending"
      ],
      "default": "pending"
    },
    "representative_id": {
      "type": "string"
    },
    "representative_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "primera_division",
        "segunda_division",
        "ascenso",
        "reserva",
        "juveniles",
        "futbol_femenino",
        "sin_club"
      ],
      "default": "primera_division"
    },
    "height": {
      "type": "number"
    },
    "weight": {
      "type": "number"
    },
    "jersey_number": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "on_loan",
        "retired",
        "archived"
      ],
      "default": "active"
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "available",
        "available_with_restrictions",
        "rehabilitation",
        "differentiated_training",
        "partial_reintegration",
        "medical_discharge",
        "sport_discharge",
        "injured",
        "on_loan",
        "transferred",
        "no_club",
        "inactive"
      ],
      "default": "available"
    },
    "linked_user_id": {
      "type": "string"
    },
    "linked_user_email": {
      "type": "string"
    },
    "portal_status": {
      "type": "string",
      "enum": [
        "not_invited",
        "pending",
        "active",
        "suspended"
      ],
      "default": "not_invited"
    },
    "external_source": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "provider_player_id": {
      "type": "string",
      "description": "API-Football player ID for stats linking"
    },
    "source_profile_url": {
      "type": "string"
    },
    "data_verified_at": {
      "type": "string",
      "format": "date"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "contract_end": {
      "type": "string",
      "format": "date"
    },
    "market_value": {
      "type": "string"
    },
    "current_club_id": {
      "type": "string"
    },
    "is_on_loan": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el jugador esta a prestamo en el club actual"
    },
    "loan_from_club": {
      "type": "string",
      "description": "Nombre del club dueno del pase (club que lo presto)"
    },
    "loan_from_club_id": {
      "type": "string",
      "description": "ID interno del club dueno del pase"
    },
    "loan_start_date": {
      "type": "string",
      "format": "date"
    },
    "loan_end_date": {
      "type": "string",
      "format": "date"
    },
    "loan_type": {
      "type": "string",
      "enum": [
        "loan",
        "loan_with_option",
        "free_transfer",
        "permanent"
      ],
      "default": "loan"
    },
    "contract_type": {
      "type": "string",
      "description": "Tipo de contrato: propiedad, prestamo, etc."
    },
    "last_transfer_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Ultima sincronizacion de datos de transferencia"
    },
    "sofascore_id": {
      "type": "string",
      "description": "ID del jugador en Sofascore"
    },
    "sofascore_rating_avg": {
      "type": "number",
      "description": "Rating promedio de Sofascore"
    }
  },
  "required": [
    "organization_id",
    "first_name",
    "last_name",
    "position"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}