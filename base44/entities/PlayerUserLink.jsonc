{
  "name": "PlayerUserLink",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "disabled"
      ],
      "default": "pending"
    },
    "invite_token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the secure invite token (never store raw token)"
    },
    "invite_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "player_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}