{
  "name": "Document",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "contract",
        "medical_report",
        "id_document",
        "passport",
        "insurance",
        "transfer",
        "image_rights",
        "sponsorship",
        "other"
      ],
      "default": "other"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "expiring_soon",
        "expired",
        "missing"
      ],
      "default": "valid"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "player_only",
        "staff_only",
        "all"
      ],
      "default": "all"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.player_id": "{{user.data.player_id}}"
            },
            {
              "data.visibility": {
                "$in": [
                  "player_only",
                  "all"
                ]
              }
            }
          ]
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}