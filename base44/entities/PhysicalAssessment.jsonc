{
  "name": "PhysicalAssessment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "cmj",
        "sprint",
        "yo_yo",
        "isometric_strength",
        "nordbord",
        "adductor",
        "mobility",
        "anthropometry",
        "custom"
      ],
      "default": "custom"
    },
    "cmj": {
      "type": "number"
    },
    "sprint_10m": {
      "type": "number"
    },
    "sprint_20m": {
      "type": "number"
    },
    "sprint_30m": {
      "type": "number"
    },
    "yo_yo_ir1": {
      "type": "number"
    },
    "isometric_strength": {
      "type": "number"
    },
    "nordbord": {
      "type": "number"
    },
    "adductor_strength": {
      "type": "number"
    },
    "mobility_score": {
      "type": "number"
    },
    "anthropometry_notes": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "performed_by": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "assessment_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}