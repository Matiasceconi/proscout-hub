{
  "name": "VideoContent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "director_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "full_match",
        "highlights",
        "match_highlight",
        "individual_actions",
        "technical_analysis",
        "tactical",
        "tactical_analysis",
        "goals_assists",
        "defensive_actions",
        "training",
        "individual",
        "presentation",
        "other"
      ],
      "default": "individual"
    },
    "match_id": {
      "type": "string"
    },
    "match_date": {
      "type": "string",
      "format": "date"
    },
    "competition": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "opponent": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "published_date": {
      "type": "string",
      "format": "date-time"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "player_only",
        "staff_only",
        "all"
      ],
      "default": "player_only"
    }
  },
  "required": [
    "organization_id",
    "title",
    "video_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.player_id": "{{user.data.player_id}}"
            },
            {
              "data.status": "published"
            }
          ]
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}