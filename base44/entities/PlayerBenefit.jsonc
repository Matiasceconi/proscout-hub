{
  "name": "PlayerBenefit",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "benefit_id": {
      "type": "string"
    },
    "benefit_name": {
      "type": "string"
    },
    "assigned_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "benefit_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}