{
  "name": "PhysicalProfile",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "height": {
      "type": "number"
    },
    "weight": {
      "type": "number"
    },
    "body_fat_percentage": {
      "type": "number"
    },
    "wingspan": {
      "type": "number"
    },
    "sitting_height": {
      "type": "number"
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organization_id",
    "player_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}