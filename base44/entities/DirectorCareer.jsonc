{
  "name": "DirectorCareer",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "director_id": {
      "type": "string"
    },
    "club": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "matches_managed": {
      "type": "number",
      "default": 0
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "draws": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "achievements": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "director_id",
    "club"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}