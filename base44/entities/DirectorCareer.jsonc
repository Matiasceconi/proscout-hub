{
  "name": "DirectorCareer",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "director_id": {
      "type": "string"
    },
    "career_key": {
      "type": "string",
      "description": "Unique key for upsert: org_id + director_id + career_key"
    },
    "club": {
      "type": "string"
    },
    "club_key": {
      "type": "string"
    },
    "club_logo_url": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "current_stage": {
      "type": "string",
      "description": "ACTUAL or FINALIZADA"
    },
    "matches_managed": {
      "type": "number",
      "default": 0
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "draws": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "points_per_match": {
      "type": "number"
    },
    "tactical_system": {
      "type": "string"
    },
    "achievements": {
      "type": "string"
    },
    "end_reason": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "verification_status": {
      "type": "string"
    },
    "is_current": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "director_id",
    "club"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}