{
  "name": "PlayerSeasonStats",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "matches": {
      "type": "number",
      "default": 0
    },
    "starts": {
      "type": "number",
      "default": 0
    },
    "minutes": {
      "type": "number",
      "default": 0
    },
    "goals": {
      "type": "number",
      "default": 0
    },
    "assists": {
      "type": "number",
      "default": 0
    },
    "call_ups": {
      "type": "number",
      "default": 0
    },
    "yellow_cards": {
      "type": "number",
      "default": 0
    },
    "red_cards": {
      "type": "number",
      "default": 0
    },
    "minutes_per_match": {
      "type": "number",
      "default": 0
    },
    "participation_rate": {
      "type": "number",
      "default": 0
    },
    "available_minutes": {
      "type": "number",
      "default": 0
    },
    "extra_stats": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "season"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}