{
  "name": "ContentView",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "video",
        "analysis",
        "document",
        "benefit"
      ]
    },
    "content_id": {
      "type": "string"
    },
    "viewed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "content_type",
    "content_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.player_id": "{{user.data.player_id}}"
        }
      ]
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}