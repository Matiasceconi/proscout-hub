{
  "name": "Match",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "opponent": {
      "type": "string"
    },
    "opponent_logo_url": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "match_date": {
      "type": "string",
      "format": "date-time"
    },
    "venue": {
      "type": "string"
    },
    "home_away": {
      "type": "string",
      "enum": [
        "home",
        "away",
        "neutral"
      ],
      "default": "home"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "finished",
        "postponed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "score": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "opponent",
    "match_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}