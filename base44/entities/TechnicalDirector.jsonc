{
  "name": "TechnicalDirector",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "photo_source_url": {
      "type": "string"
    },
    "photo_source_name": {
      "type": "string"
    },
    "photo_source_type": {
      "type": "string",
      "enum": [
        "authorized",
        "official_club",
        "league_federation",
        "verified_channel",
        "public_reference"
      ]
    },
    "photo_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "photo_rights_status": {
      "type": "string"
    },
    "photo_status": {
      "type": "string",
      "enum": [
        "ok",
        "pending"
      ],
      "default": "pending"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "nationality": {
      "type": "string"
    },
    "country_of_residence": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "coaching_license": {
      "type": "string"
    },
    "primary_role": {
      "type": "string",
      "enum": [
        "director_tecnico",
        "entrenador_asistente",
        "director_deportivo",
        "ayudante_campo",
        "preparador_fisico",
        "entrenador_arqueros",
        "analista_video",
        "coordinador_deportivo"
      ],
      "default": "director_tecnico"
    },
    "current_club": {
      "type": "string"
    },
    "last_club": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "professional_status": {
      "type": "string",
      "enum": [
        "with_club",
        "available",
        "in_negotiation",
        "active_project",
        "inactive"
      ],
      "default": "available"
    },
    "representative_id": {
      "type": "string"
    },
    "representative_name": {
      "type": "string"
    },
    "joined_date": {
      "type": "string",
      "format": "date"
    },
    "biography": {
      "type": "string"
    },
    "game_model": {
      "type": "string"
    },
    "preferred_tactical_system": {
      "type": "string"
    },
    "languages": {
      "type": "string"
    },
    "main_achievements": {
      "type": "string"
    },
    "presentation_url": {
      "type": "string"
    },
    "linked_user_id": {
      "type": "string"
    },
    "portal_status": {
      "type": "string",
      "enum": [
        "not_invited",
        "pending",
        "active",
        "suspended"
      ],
      "default": "not_invited"
    },
    "external_source": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "source_profile_url": {
      "type": "string"
    },
    "data_verified_at": {
      "type": "string",
      "format": "date"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "current_club_id": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "first_name",
    "last_name",
    "primary_role"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}