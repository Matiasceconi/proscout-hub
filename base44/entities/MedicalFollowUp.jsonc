{
  "name": "MedicalFollowUp",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "injury_id": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "professional": {
      "type": "string"
    },
    "evolution": {
      "type": "string",
      "enum": [
        "improving",
        "stable",
        "worsening",
        "recovered"
      ],
      "default": "stable"
    },
    "notes": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "general",
        "rehab",
        "clinical"
      ],
      "default": "general"
    },
    "shared_with_player": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organization_id",
    "player_id",
    "follow_up_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.player_id": "{{user.data.player_id}}"
            },
            {
              "data.shared_with_player": true
            }
          ]
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}