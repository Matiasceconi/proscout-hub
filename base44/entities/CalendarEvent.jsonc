{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "director_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "match",
        "training",
        "medical",
        "travel",
        "media",
        "meeting",
        "signing",
        "presentation",
        "press",
        "follow_up",
        "internal_task",
        "other"
      ],
      "default": "other"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "scheduled"
    },
    "responsible_member_id": {
      "type": "string",
      "description": "OrganizationMember ID of the responsible agent"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "all_day": {
      "type": "boolean",
      "default": false
    },
    "reminder_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "fixture",
        "document",
        "contract",
        "birthday",
        "follow_up"
      ],
      "default": "manual"
    },
    "source_id": {
      "type": "string",
      "description": "ID of the source record (fixture, document, player, etc.)"
    },
    "created_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "title",
    "start_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.data.player_id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}